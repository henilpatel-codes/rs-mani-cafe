# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────
# Replace with your Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/rs_mani_cafe?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars

# ─── Razorpay ─────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Email (for OTP / password reset) ────────────────────────
# Use Gmail App Password (not your Gmail password)
# Enable: Google Account → Security → 2FA → App Passwords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password_16chars

# ─── Frontend URL (for CORS) ──────────────────────────────────
# Local: http://localhost:5173
# Production: https://your-vercel-app.vercel.app
FRONTEND_URL=http://localhost:5173

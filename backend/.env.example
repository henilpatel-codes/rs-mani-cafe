# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/rs_mani_cafe?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars

# Razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Email Provider
# Local Gmail: EMAIL_PROVIDER=gmail
# Production Render Brevo: EMAIL_PROVIDER=brevo
EMAIL_PROVIDER=gmail
EMAIL_SKIP=false
SKIP_EMAIL=false

# Gmail SMTP - Local optional
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password_16chars

# Brevo Transactional Email API - Production Render
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_EMAIL=your_verified_sender_email
EMAIL_FROM_NAME=RS MANI Cafe

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
